# QVAULT Scripts — Environment Variables
# Copy to .env and fill in. NEVER commit .env.

SOLANA_NETWORK=devnet
RPC_URL=https://api.devnet.solana.com

# Path to keypair — use a DEVNET-only keypair for testing.
# For mainnet, the human signs manually — do NOT store mainnet keys here.
ANCHOR_WALLET=~/.config/solana/devnet.json

PROGRAM_ID=QVLTxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
