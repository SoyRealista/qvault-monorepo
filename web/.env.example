# QVAULT Web — Environment Variables
# Copy to .env and fill in. NEVER commit .env.

# Solana network: devnet | mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Program ID (from `anchor deploy` — update after deploy)
NEXT_PUBLIC_PROGRAM_ID=QVLTxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Token mint (set after initialize)
NEXT_PUBLIC_QVLT_MINT=

# Optional: analytics, API endpoints (Phase 3)
# NEXT_PUBLIC_API_URL=
